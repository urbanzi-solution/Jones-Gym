      "updated": 1758770173956,
      "link": null,
      "locked": false,
      "text": "first check the data in the membershipPlans-balance if it is 0 then remove the data from the \nsortedMembers using the user_id remove\nif the balance is not zero the check the data with the same bill_no in the transactions with the \nold_bill, if the bill_no and the old_bill same then then go for the checking in the transactions data \nbalance for 0, if 0 then remove it from the sortedMembers with the same old_bill which matches the \nuser_id in the both and the bill_no  int he membershipPlans and old_bill in the transactions",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "first check the data in the membershipPlans-balance if it is 0 then remove the data from the \nsortedMembers using the user_id remove\nif the balance is not zero the check the data with the same bill_no in the transactions with the \nold_bill, if the bill_no and the old_bill same then then go for the checking in the transactions data \nbalance for 0, if 0 then remove it from the sortedMembers with the same old_bill which matches the \nuser_id in the both and the bill_no  int he membershipPlans and old_bill in the transactions",
      "autoResize": true,
      "lineHeight": 1.25
    },
